{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karaoke-frontend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BACKEND_API_ORIGIN": "https://karaoke-backend-production.marclouiegi-olino.workers.dev"
  },
  "services": [
    {
      "binding": "BACKEND_API",
      "service": "karaoke-backend-production"
    }
  ]
}
