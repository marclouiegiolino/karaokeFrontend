{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karaoke-frontend-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BACKEND_API_ORIGIN": "http://localhost:8787"
  }
}
